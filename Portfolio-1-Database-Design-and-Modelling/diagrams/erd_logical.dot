digraph ERD {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.3, newrank=true, pad=0.4, bgcolor="white", fontname="Inter", label=<<B>Wayne's Clinic Baltimore — Logical ERD (Crow's Foot)</B><BR/><FONT POINT-SIZE="11" COLOR="#475569">Generated from the PostgreSQL 16 catalogue · PK primary key · FK foreign key · UK unique · ? nullable · solid line = identifying, dashed = non-identifying</FONT>>, labelloc=t, fontsize=20];
  node [shape=plain, fontname="Inter", fontsize=11];
  edge [fontname="Inter", color="#475569", penwidth=1.3, arrowsize=0.9];
  subgraph cluster_Patients { label=<<B>Patients</B>>; fontcolor="#1d4ed8"; color="#1d4ed840"; style="rounded,dashed"; fontsize=13;
    patient [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1d4ed8" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>patient</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="patient_id"><B>patient_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="mrn">mrn</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="first_name">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="last_name">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="date_of_birth">date_of_birth</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="sex">sex</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">char(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="blood_group">blood_group<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="phone">phone<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">phone_number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="email">email<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">email_address</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="street_address">street_address<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="zip_code">zip_code<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">char(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="emergency_contact_name">emergency_contact_name<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="emergency_contact_phone">emergency_contact_phone<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">phone_number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="registered_at">registered_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR></TABLE>>];
    patient_allergy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1d4ed8" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>patient_allergy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" PORT="patient_id"><B>patient_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" PORT="medication_id"><B>medication_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="reaction">reaction</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="severity">severity</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="recorded_at">recorded_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR></TABLE>>];
    postal_area [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1d4ed8" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>postal_area</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="zip_code"><B>zip_code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">char(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="city">city</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="state_code">state_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">char(2)</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_Staff { label=<<B>Staff</B>>; fontcolor="#6d28d9"; color="#6d28d940"; style="rounded,dashed"; fontsize=13;
    doctor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6d28d9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>doctor</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="doctor_id"><B>doctor_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="staff_number">staff_number</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="first_name">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="last_name">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="specialty_id">specialty_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="department_id">department_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="license_number">license_number</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">email_address</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="phone">phone<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">phone_number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="hire_date">hire_date</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="consultation_minutes">consultation_minutes</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">boolean</FONT></TD></TR></TABLE>>];
    department [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6d28d9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>department</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="department_id"><B>department_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="floor_number">floor_number</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="phone_extension">phone_extension</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(6)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="head_doctor_id">head_doctor_id<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR></TABLE>>];
    specialty [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6d28d9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>specialty</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="specialty_id"><B>specialty_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(80)</FONT></TD></TR></TABLE>>];
    doctor_availability [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6d28d9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>doctor_availability</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" PORT="doctor_id"><B>doctor_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="iso_weekday"><B>iso_weekday</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6d28d9" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="start_time"><B>start_time</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">time</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="end_time">end_time</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">time</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_Scheduling { label=<<B>Scheduling</B>>; fontcolor="#0f766e"; color="#0f766e40"; style="rounded,dashed"; fontsize=13;
    appointment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0f766e" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>appointment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#0f766e" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="appointment_id"><B>appointment_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#0f766e" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#0f766e" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="doctor_id">doctor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="scheduled_start">scheduled_start</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="scheduled_end">scheduled_end</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">appointment_status</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="reason">reason<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="booked_at">booked_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_Clinical { label=<<B>Clinical</B>>; fontcolor="#15803d"; color="#15803d40"; style="rounded,dashed"; fontsize=13;
    diagnosis [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#15803d" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>diagnosis</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#15803d" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="diagnosis_id"><B>diagnosis_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#15803d" POINT-SIZE="9"><B>FK,UK</B></FONT></TD><TD ALIGN="LEFT" PORT="appointment_id">appointment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#15803d" POINT-SIZE="9"><B>FK,UK</B></FONT></TD><TD ALIGN="LEFT" PORT="icd10_code">icd10_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(8)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="diagnosis_type">diagnosis_type</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="clinical_notes">clinical_notes<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="diagnosed_at">diagnosed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR></TABLE>>];
    icd10_code [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#15803d" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>icd10_code</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#15803d" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="icd10_code"><B>icd10_code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(8)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="chapter">chapter</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(80)</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_Pharmacy { label=<<B>Pharmacy</B>>; fontcolor="#b45309"; color="#b4530940"; style="rounded,dashed"; fontsize=13;
    prescription [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#b45309" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>prescription</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="prescription_id"><B>prescription_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="appointment_id">appointment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="issued_at">issued_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="notes">notes<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(300)</FONT></TD></TR></TABLE>>];
    prescription_item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#b45309" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>prescription_item</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" PORT="prescription_id"><B>prescription_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="line_no"><B>line_no</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>FK,UK</B></FONT></TD><TD ALIGN="LEFT" PORT="medication_id">medication_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="dosage">dosage</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="frequency">frequency</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="duration_days">duration_days</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR></TABLE>>];
    medication [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#b45309" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>medication</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="medication_id"><B>medication_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="ndc_code">ndc_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(13)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="generic_name">generic_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="brand_name">brand_name<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="dosage_form">dosage_form</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#b45309" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="strength">strength</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="stock_on_hand">stock_on_hand</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="is_controlled">is_controlled</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">boolean</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_Laboratory { label=<<B>Laboratory</B>>; fontcolor="#be123c"; color="#be123c40"; style="rounded,dashed"; fontsize=13;
    lab_order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#be123c" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>lab_order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#be123c" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="lab_order_id"><B>lab_order_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#be123c" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="appointment_id">appointment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="ordered_at">ordered_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="priority">priority</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(8)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(12)</FONT></TD></TR></TABLE>>];
    lab_result [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#be123c" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>lab_result</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#be123c" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="lab_result_id"><B>lab_result_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#be123c" POINT-SIZE="9"><B>FK,UK</B></FONT></TD><TD ALIGN="LEFT" PORT="lab_order_id">lab_order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#be123c" POINT-SIZE="9"><B>FK,UK</B></FONT></TD><TD ALIGN="LEFT" PORT="test_code">test_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="result_value">result_value<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">numeric(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="result_text">result_text<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="abnormal_flag">abnormal_flag<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">char(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="resulted_at">resulted_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">timestamptz</FONT></TD></TR></TABLE>>];
    lab_test [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#cbd5e1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#be123c" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="13"><B>lab_test</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#be123c" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="test_code"><B>test_code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#be123c" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT" PORT="test_name">test_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="specimen_type">specimen_type</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="unit">unit<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="ref_low">ref_low<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">numeric(10,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="ref_high">ref_high<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">numeric(10,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="critical_low">critical_low<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">numeric(10,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="critical_high">critical_high<FONT COLOR="#94a3b8"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">numeric(10,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT" PORT="turnaround_hours">turnaround_hours</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">smallint</FONT></TD></TR></TABLE>>];
  }
  specialty -> doctor [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, tooltip="fk_doctor_specialty"];
  department -> doctor [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, tooltip="fk_doctor_department"];
